// CONFIGURAÇÃO DO CLIENTE E BASE DE DADOS
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Usado só pelo `prisma migrate` (precisa de ligação "de sessão longa").
  // O runtime (app a correr) usa sempre DATABASE_URL (pooler em modo
  // transaction, porta 6543) - ver DIRECT_URL no .env.
  directUrl = env("DIRECT_URL")
}

// ENUMS (TIPOS ESTRUTURADOS)
// Ficam enum porque estão presos a código (strategies OAuth, guards de role),
// adicionar um valor novo implica sempre escrever código novo, por isso não
// faz sentido serem "editáveis" pelo admin.

// Provedores de Autenticação OAuth suportados.
enum Provider {
  GOOGLE
  DISCORD
  GITHUB
}

// Roles
enum Role {
  USER
  ADMIN
}

// Tipos de evento de segurança registados. Por agora só há um gatilho (o
// ThrottlerGuard a bloquear um IP), mas fica como enum já para permitir
// adicionar outros tipos de deteção no futuro (ex: falhas de login
// repetidas) sem migrar a coluna de String para enum mais tarde.
enum SecurityEventType {
  RATE_LIMIT_EXCEEDED
}

// Estado de progresso aplicável a qualquer tarefa ou projeto.
enum ProgressStatus {
  AHEAD
  ON_TRACK
  BEHIND
  VERY_BEHIND
  COMPLETED
}

// Escala de dificuldade percebida para a tarefa.
enum Difficulty {
  VERY_EASY
  EASY
  MEDIUM
  HARD
  VERY_HARD
}

// TABELAS DE CONFIGURAÇÃO (SUBSTITUEM OS ANTIGOS ENUMS TaskType/AcademicTaskType)
// Estas deixaram de ser enum porque queremos que o ADMIN as edite (label, cor,
// ordem, ativo/inativo) sem precisar de deploy nem migration.
//
// `key` = identificador estável usado pelo código (ex: comparações "=== 'ACADEMICO'").
//         Nunca deve ser editado depois de criado.
// `label` = texto mostrado na UI. Este sim é o que o admin edita livremente.

/// Categoria principal da Tarefa (Abstração de alto nível).
model TaskType {
  id       String  @id @default(uuid())
  key      String  @unique
  label    String
  colorHex String? @default("#808080")
  order    Int     @default(0)
  isActive Boolean @default(true)

  academicTaskTypes AcademicTaskType[]
  tasks             Task[]
  // Areas que usam este TaskType como valor por omissão (ex: "CDR" -> Académico).
  areasWithDefault  Area[]             @relation("AreaDefaultTaskType")
}

/// Subcategoria estritamente focada na vida académica.
/// Só é relevante quando o TaskType pai tiver key = "ACADEMICO".
model AcademicTaskType {
  id       String  @id @default(uuid())
  key      String  @unique
  label    String
  order    Int     @default(0)
  isActive Boolean @default(true)

  taskTypeId String
  taskType   TaskType @relation(fields: [taskTypeId], references: [id])

  tasks Task[]
}

// MODELOS (TABELAS DA BASE DE DADOS)

/// Representa um utilizador da plataforma.
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  role      Role     @default(USER)
  name      String?
  avatarUrl String?
  createdAt DateTime @default(now())

  // Id do utilizador no Supabase Auth (auth.users), só existe para contas
  // email+password. Precisamos disto para apagar a credencial real no
  // deleteAccount - sem isto, apagar o User "espelho" não apaga o login,
  // e a conta "ressuscita" sozinha na próxima vez que a pessoa fizer login.
  supabaseAuthId String? @unique

  // Relações
  identities    Identity[]
  tasks         Task[]
  apiKeys       ApiKey[]
  securityLogs  SecurityLog[]
  studySessions StudySession[]
}

model ApiKey {
  id        String    @id @default(uuid())
  userId    String
  keyHash   String    @unique
  name      String
  createdAt DateTime  @default(now())
  lastUsed  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // userId nunca é indexado automaticamente só por ser FK - exportUserData()
  // (users.service.ts) faz findMany({ where: { userId } }) para listar as
  // keys de uma pessoa, sem isto seria sempre um scan à tabela toda.
  @@index([userId])
}

/// Gere os tokens e IDs externos para autenticação OAuth (SSO).
model Identity {
  id                String    @id @default(uuid())
  userId            String
  provider          Provider
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  scope             String?
  createdAt         DateTime  @default(now())

  // Relações
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Garante que o mesmo providerAccount não é associado duas vezes
  @@unique([provider, providerAccountId])
  // userId sozinho (sem o provider) é usado em getProviders(),
  // getDecryptedProviderTokens() e no cascade delete de User - o
  // @@unique acima não serve para essas queries porque começa por
  // "provider", não por "userId".
  @@index([userId])
}

/// Abstração que representa um "Balde" ou "Área de Vida".
model Area {
  id       String @id @default(uuid())
  name     String
  colorHex String @default("#808080")

  // Opcional: liga esta Area a um TaskType por omissão (ex: "CDR" -> Académico,
  // "Natação" fica null). Quando definido, o frontend pré-seleciona e tranca o
  // Type ao criar uma task nesta Area, e esconde os campos só-académicos
  // (nota, peso) para Areas sem tipo associado.
  defaultTaskTypeId String?
  defaultTaskType   TaskType? @relation("AreaDefaultTaskType", fields: [defaultTaskTypeId], references: [id])

  // Relações
  tasks         Task[]
  studySessions StudySession[]
}

/// Representa uma ação executável dentro de uma Área (Area).
model Task {
  id     String   @id @default(uuid())
  userId String
  areaId String
  title  String
  date   DateTime

  // Tipologia e Categorização
  taskTypeId     String
  taskType       TaskType          @relation(fields: [taskTypeId], references: [id])
  academicTypeId String?
  academicType   AcademicTaskType? @relation(fields: [academicTypeId], references: [id])
  topics         String?

  // Metadados de Execução
  weightPercentage Float?
  difficulty       Difficulty
  progressStatus   ProgressStatus @default(ON_TRACK)
  referenceLink    String?

  // Avaliação (Relevante para contexto Académico/Trabalho)
  targetGrade Float?
  realGrade   Float?

  completedAt DateTime?

  // Última vez que perguntámos ao user se esta task (já fora de prazo) está
  // feita ou não (feature de "overdue check-in", ver tasks.service.ts).
  // Serve só para não repetir a pergunta várias vezes no mesmo dia - a
  // pergunta volta a aparecer no dia seguinte enquanto a task não passar a
  // COMPLETED. Não precisa de índice: é sempre lido junto com o filtro por
  // userId + date, que já cobre a query.
  lastOverdueCheckAt DateTime?

  // Integrações
  googleCalendarEventId String?
  // Duração em minutos do evento no Google Calendar, só relevante quando a
  // Task tem hora definida (evento "dia inteiro" ignora isto). Null =
  // continua a usar o default de 60min no CalendarService, para tasks
  // antigas criadas antes deste campo existir.
  calendarDurationMinutes Int?
  createdAt             DateTime @default(now())

  // Relações
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  area Area @relation(fields: [areaId], references: [id])
  studySessions StudySession[]

  // Nenhuma destas é indexada automaticamente só por ser FK no Postgres:
  // - userId: TasksService.findAll/findOne/update/remove filtram sempre
  //   por ele (where: { userId, ... }) - é a query mais frequente de
  //   toda a app, sem índice degrada para scan completo à tabela Task
  //   à medida que ela cresce.
  // - areaId / taskTypeId / academicTypeId: sem índice, apagar uma Area
  //   ou um TaskType obriga o Postgres a percorrer a tabela Task inteira
  //   só para verificar se a FK constraint permite o apagar.
  @@index([userId])
  @@index([areaId])
  @@index([taskTypeId])
  @@index([academicTypeId])
}

/// Registo persistente de eventos de segurança - hoje só bloqueios do
/// ThrottlerGuard (candidatos a tentativa de DoS/força bruta), escrito por
/// LoggingThrottlerGuard sempre que um IP excede o limite de pedidos.
/// Distinto do RequestUserLoggerInterceptor (esse só imprime no terminal,
/// não fica gravado - some com o restart do dyno do Render).
model SecurityLog {
  id        String            @id @default(uuid())
  type      SecurityEventType @default(RATE_LIMIT_EXCEEDED)
  ip        String
  method    String
  path      String
  userAgent String?
  count     Int               @default(1) // quantos bloqueios agregados nesta linha (ver LoggingThrottlerGuard)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @default(now()) @updatedAt

  // A maioria dos bloqueios acontece SEM sessão (é precisamente o padrão
  // de um ataque), por isso opcional. Se o attacker tiver sessão válida
  // (ex: script autenticado a martelar um endpoint), guardamos quem é -
  // mas nunca apagamos o log só porque a conta foi apagada depois.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // ip: a query mais comum do admin é "o que fez este IP" / agrupar por IP
  // para o ranking de piores ofensores.
  // createdAt: listagem é sempre ordenada e filtrada por período recente -
  // sem índice degrada para scan completo à medida que a tabela cresce.
  @@index([ip])
  @@index([createdAt])
  @@index([userId])
}

/// Uma sessão de estudo/foco: início, fim (null enquanto está a decorrer),
/// opcionalmente ligada a uma Task ou Area, com nota livre. Usada pela
/// página Focus para: (1) o widget de sessão ativa, (2) o heatmap de
/// melhores horas para estudar, (3) histórico.
model StudySession {
  id        String    @id @default(uuid())
  userId    String
  startedAt DateTime  @default(now())
  // null enquanto a sessão está a decorrer - é o que StudySessionsService
  // usa para saber se há uma sessão "ativa" (no máximo 1 por utilizador).
  endedAt   DateTime?
  note      String?
  createdAt DateTime  @default(now())

  // Opcionais e independentes um do outro: dá para começar uma sessão sem
  // apontar a task/area nenhuma ("estudo genérico"), só a uma Area (ex:
  // "Networking" em geral), só a uma Task, ou às duas.
  taskId String?
  areaId String?

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  // onDelete: SetNull - apagar uma Task/Area não deve apagar o histórico
  // de sessões de estudo já registadas, só desassociar.
  task Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  area Area? @relation(fields: [areaId], references: [id], onDelete: SetNull)

  // userId: toda a gente das queries (ativa, heatmap, histórico) filtra
  // sempre por dono - é a query mais frequente deste modelo.
  // [userId, startedAt]: o heatmap e o histórico ordenam/filtram sempre
  // por período dentro do próprio utilizador.
  @@index([userId])
  @@index([userId, startedAt])
  @@index([taskId])
  @@index([areaId])
}
