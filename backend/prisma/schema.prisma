// CONFIGURAÇÃO DO CLIENTE E BASE DE DADOS
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Usado só pelo `prisma migrate` (precisa de ligação "de sessão longa").
  // O runtime (app a correr) usa sempre DATABASE_URL (pooler em modo
  // transaction, porta 6543) - ver DIRECT_URL no .env.
  directUrl = env("DIRECT_URL")
}

// ENUMS (TIPOS ESTRUTURADOS)
// Ficam enum porque estão presos a código (strategies OAuth, guards de role),
// adicionar um valor novo implica sempre escrever código novo, por isso não
// faz sentido serem "editáveis" pelo admin.

// Provedores de Autenticação OAuth suportados.
enum Provider {
  GOOGLE
  DISCORD
  GITHUB
}

// Roles
enum Role {
  USER
  ADMIN
}

/// Estado do pedido para uma Area privada passar a oficial.
/// NONE = nunca pedida (ou retirada); PENDING = à espera do admin;
/// REJECTED = o admin recusou (a Area continua privada do dono, que pode
/// voltar a propor depois de a corrigir).
enum AreaProposalStatus {
  NONE
  PENDING
  REJECTED
}

// ACTIVE: normal. SUSPENDED: temporário, sempre com suspendedUntil
// definido (auto-reativa sozinho quando essa data passa - ver
// JwtStrategy.validate() e UsersService.isBlocked()). BANNED:
// permanente, sem suspendedUntil.
enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum AppealResolution {
  APPROVED
  DENIED
}

// TASKS: can only do what the agent/task automation already needed
// (tasks, agent config). ADMIN: can also manage the global catalog
// (Areas, TaskTypes) via API key, same as an admin's browser session.
// Kept as a real Postgres enum (not the generic EnumOption table used
// for Difficulty/ProgressStatus/etc.) because this is a security control,
// not editable product content - see Role/Provider above for the same
// reasoning.
enum ApiKeyScope {
  TASKS
  ADMIN
}

// Tipos de evento de segurança registados. Por agora só há um gatilho (o
// ThrottlerGuard a bloquear um IP), mas fica como enum já para permitir
// adicionar outros tipos de deteção no futuro (ex: falhas de login
// repetidas) sem migrar a coluna de String para enum mais tarde.
enum SecurityEventType {
  RATE_LIMIT_EXCEEDED
  // Um admin apagou um pad (moderacao, ver PadsService.removeAsAdmin).
  ADMIN_PAD_DELETED
  // Um admin bloqueou uma origem sem conta de escrever em pads.
  ADMIN_PAD_SOURCE_BLOCKED
}

// Estado de progresso aplicável a qualquer tarefa ou projeto.
enum ProgressStatus {
  AHEAD
  ON_TRACK
  BEHIND
  VERY_BEHIND
  COMPLETED
}

// Quanto trabalho a task da, independente de quao dificil e: uma task pode
// ser facil e ao mesmo tempo exaustiva (muitas paginas, muitos exercicios).
// Multiplica a estimativa de tempo de estudo (ver EFFORT_MULTIPLIER em
// study-plan.constants.ts). null = MODERATE.
enum Effort {
  LIGHT
  MODERATE
  HEAVY
  EXHAUSTIVE
}

// Quao certa e a data da task. A coluna `date` continua obrigatoria (e a
// melhor estimativa), isto so diz como a tratar:
// - EXACT: prazo real.
// - APPROXIMATE: "por volta de", conta como prazo mas mostra-se com "~".
// - UNKNOWN: ainda nao foi marcada. Nunca fica em atraso nem aparece em "Hoje".
// - SURPRISE: pode calhar em qualquer dia (mini-teste surpresa). Nunca fica
//   em atraso; o plano de estudo tenta ter-te pronto cedo.
enum DateCertainty {
  EXACT
  APPROXIMATE
  UNKNOWN
  SURPRISE
}

// Escala de dificuldade percebida para a tarefa.
enum Difficulty {
  VERY_EASY
  EASY
  MEDIUM
  HARD
  VERY_HARD
}

// Como o user chega ao campus - nem todo o estudante tem carro (a pé +
// metro é tão válido como conduzir). Usado por
// ScheduleService.estimateCommute() para escolher o `mode` certo no
// pedido à Google Distance Matrix API (os valores batem certo com os
// aceites pela própria API: driving/walking/bicycling/transit). Também
// guardado mesmo quando o commute é definido manualmente (sem chamar a
// API), só para o CommuteSettingsCard lembrar a escolha da próxima vez
// que o user abrir a página - não afeta em nada o StudyPlanService, que
// só olha para commuteMinutes, seja qual for o modo por trás do número.
enum CommuteMode {
  DRIVING
  WALKING
  BICYCLING
  TRANSIT
}

// Priority deixou de ser um enum fixo (ver TaskType/AcademicTaskType logo
// abaixo, mesma decisão já tomada para eles) - passou a ser um catálogo
// editável pelo admin em runtime, sem precisar de deploy para
// adicionar/renomear/reordenar níveis de prioridade. Ver model Priority.

// Como as regras dentro de AgentConfig se combinam: ANY (basta uma regra
// ativa dar true) ou ALL (todas as regras ativas têm de dar true).
enum AgentTriggerMode {
  ANY
  ALL
}

// O que o agente local faz quando não consegue contactar a API para
// buscar a configuração/tasks atualizadas.
enum AgentFailMode {
  CLOSED
  OPEN
}

// TABELAS DE CONFIGURAÇÃO (SUBSTITUEM OS ANTIGOS ENUMS TaskType/AcademicTaskType)
// Estas deixaram de ser enum porque queremos que o ADMIN as edite (label, cor,
// ordem, ativo/inativo) sem precisar de deploy nem migration.
//
// `key` = identificador estável usado pelo código (ex: comparações "=== 'ACADEMICO'").
//         Nunca deve ser editado depois de criado.
// `label` = texto mostrado na UI. Este sim é o que o admin edita livremente.

/// Categoria principal da Tarefa (Abstração de alto nível).
model TaskType {
  id       String  @id @default(uuid())
  key      String  @unique
  label    String
  colorHex String? @default("#808080")
  order    Int     @default(0)
  isActive Boolean @default(true)

  academicTaskTypes AcademicTaskType[]
  tasks             Task[]
  // Areas que usam este TaskType como valor por omissão (ex: "CDR" -> Académico).
  areasWithDefault  Area[]             @relation("AreaDefaultTaskType")
}

/// Subcategoria estritamente focada na vida académica.
/// Só é relevante quando o TaskType pai tiver key = "ACADEMICO".
model AcademicTaskType {
  id       String  @id @default(uuid())
  key      String  @unique
  label    String
  order    Int     @default(0)
  isActive Boolean @default(true)

  /// Tipo de data fixa (teste, exame, apresentação): a "data" é o momento do
  /// evento, não um prazo de entrega. Marcar como feito depois do dia NUNCA
  /// conta como atraso, e a pergunta "isto já está feito?" não aparece.
  isEvent Boolean @default(false)

  taskTypeId String
  taskType   TaskType @relation(fields: [taskTypeId], references: [id])

  tasks Task[]
}

/// Urgência manual da task, independente da Difficulty (uma task pode ser
/// "fácil" e "urgente" ao mesmo tempo, ex: um email rápido que tem de sair
/// hoje). Mesmo padrão do TaskType: catálogo editável pelo admin em
/// runtime (label/colorHex/order), não um enum preso ao código - deixa de
/// ser preciso um deploy para renomear/reordenar/adicionar níveis.
model Priority {
  id       String  @id @default(uuid())
  key      String  @unique
  label    String
  colorHex String? @default("#808080")
  order    Int     @default(0)
  isActive Boolean @default(true)

  tasks Task[]
}

// MODELOS (TABELAS DA BASE DE DADOS)

/// Representa um utilizador da plataforma.
model User {
  id        String   @id @default(uuid())
  // Areas privadas criadas por este user (ver Area.ownerId).
  ownedAreas Area[] @relation("UserOwnedAreas")
  // Areas oficiais que este user desligou (ver AreaHidden).
  hiddenAreas AreaHidden[]
  pushSubscriptions PushSubscription[]
  shareVisits       ShareVisit[]
  feedbackEntries   Feedback[]
  taskPacks         TaskPack[]
  taskPackUpdates   TaskPackUpdate[]
  // Social: codigo de amigo aleatorio (criado a pedido), amizades e bloqueios.
  friendCode        String?  @unique
  friendCodeRequests  FriendCodeChangeRequest[]
  friendshipsSent     Friendship[] @relation("FriendshipRequester")
  friendshipsReceived Friendship[] @relation("FriendshipAddressee")
  blocksMade          UserBlock[]  @relation("BlockMaker")
  blocksReceived      UserBlock[]  @relation("BlockTarget")
  notesGrantsGiven    NotebookViewGrant[] @relation("ViewGrantOwner")
  notesGrantsReceived NotebookViewGrant[] @relation("ViewGrantViewer")
  email     String   @unique
  role      Role     @default(USER)
  name      String?
  avatarUrl String?
  createdAt DateTime @default(now())

  // Ban/suspend - efeito imediato mesmo com um JWT ainda válido (ver
  // JwtStrategy.validate(), que consulta isto por request). SUSPENDED
  // sempre com suspendedUntil definido; passada essa data, tratado como
  // ACTIVE automaticamente (sem cron - ver UsersService.isBlocked/
  // reactivateIfExpired). BANNED nunca tem suspendedUntil (indefinido).
  status                UserStatus @default(ACTIVE)
  suspendedUntil        DateTime?
  statusReason          String?
  statusUpdatedAt       DateTime?
  statusUpdatedByUserId String?
  statusUpdatedBy       User?      @relation("UserStatusChangedBy", fields: [statusUpdatedByUserId], references: [id], onDelete: SetNull)
  statusChangesMade     User[]     @relation("UserStatusChangedBy")

  // Pedidos de recurso contra a própria suspensão/ban (AccountBlockedPage
  // no frontend) - ver o modelo UserAppeal. appealsResolved é o lado do
  // ADMIN que decidiu (approve/deny), nunca a mesma pessoa que "appeals".
  appeals         UserAppeal[] @relation("UserAppeals")
  appealsResolved UserAppeal[] @relation("UserAppealResolutions")


  // Id do utilizador no Supabase Auth (auth.users), só existe para contas
  // email+password. Precisamos disto para apagar a credencial real no
  // deleteAccount - sem isto, apagar o User "espelho" não apaga o login,
  // e a conta "ressuscita" sozinha na próxima vez que a pessoa fizer login.
  supabaseAuthId String? @unique

  // Versao das sessoes do utilizador: o JWT leva este numero (claim `tv`) e
  // deixa de valer assim que for incrementado (terminar sessao em todos os
  // dispositivos, troca de password, merge OAuth). Ver SessionStateService.
  tokenVersion Int @default(0)

  // Dashboard ativo (Programa + Período selecionados) - guardado aqui em vez
  // de só em localStorage para persistir entre sessões/dispositivos (ver
  // PeriodsService.resolveActivePeriod). SetNull porque um Program/Period
  // nunca é hard-deleted (só arquivado), mas fica cá por segurança - se
  // algum dia passar a existir um delete real, o user não fica com uma FK
  // pendurada.
  activeProgramId String?
  activeProgram   AcademicProgram? @relation("UserActiveProgram", fields: [activeProgramId], references: [id], onDelete: SetNull)
  activePeriodId  String?
  activePeriod    AcademicPeriod?  @relation("UserActivePeriod", fields: [activePeriodId], references: [id], onDelete: SetNull)

  // Horário/plano de estudo (Fase 6) - tudo opcional, null = feature nunca
  // configurada por este user, não "configurada com valor zero".
  //
  // commuteMinutes: buffer de viagem (minutos, um sentido) aplicado antes/
  // depois de blocos de aulas presenciais no cálculo de tempo livre do
  // StudyPlanService. Pode ser escrito à mão OU calculado a partir de
  // homeAddress/campusAddress via POST /schedule/commute/estimate (Google
  // Maps Distance Matrix, só corre com GOOGLE_MAPS_API_KEY configurada) -
  // de qualquer forma o resultado fica sempre neste único campo, o
  // gerador de plano nunca precisa de saber qual dos dois caminhos foi
  // usado.
  commuteMinutes Int?
  homeAddress    String?
  campusAddress  String?
  // Tem default (ao contrário dos outros campos desta secção) porque não
  // faz sentido ficar "por definir" - o dropdown no frontend precisa
  // sempre de um valor selecionado, e TRANSIT é a opção mais segura para
  // quem ainda não configurou nada (não assume que toda a gente tem
  // carro).
  commuteMode CommuteMode @default(TRANSIT)

  // Janela de sono/indisponibilidade, em minutos desde a meia-noite (hora
  // de Lisboa). Suporta virar a meia-noite (ex: 23:00-07:00 ->
  // start=1380, end=420) - ver isWithinQuietHours() em
  // study-plan.service.ts. Os dois só contam quando ambos estão
  // definidos; um sozinho é tratado como "nunca configurado" (evita gerar
  // uma janela de 0 minutos ou o dia inteiro por engano a partir de um
  // valor a meio).
  quietHoursStart Int?
  quietHoursEnd   Int?

  // Limite de estudo por dia usado pelo plano (minutos). null = default do
  // servidor (DEFAULT_DAILY_STUDY_LIMIT_MINUTES em study-plan.constants.ts).
  // Estudo planeado acima disto conta como overtime.
  dailyStudyLimitMinutes Int?

  // Verificação de email (Supabase Auth + email enviado pelo nosso MailService).
  // `@default(now())` é DELIBERADO: ao correr `prisma migrate dev`, todas as
  // contas que já existem ficam logo marcadas como verificadas (o Postgres
  // preenche a coluna nova com o default) - ligar a verificação mais tarde
  // nunca bloqueia utilizadores atuais. Quem se regista por email+password
  // nasce com `emailVerifiedAt: null` explícito (ver PasswordAuthService),
  // contas OAuth ficam com o default (o provider já verificou o email).
  // Só é EXIGIDO quando REQUIRE_EMAIL_VERIFICATION=true no backend; com a
  // flag a false isto é só informação e ninguém é bloqueado.
  emailVerifiedAt DateTime? @default(now())

  // Preferências (Profile > Preferences). Ambas DESLIGADAS por omissão.
  // Email 24h antes do prazo das tasks pendentes (ver RemindersService).
  deadlineEmailReminders Boolean @default(false)
  // Push (nos dispositivos com notificacoes ligadas) com o mesmo calendario
  // do email acima. Desligado por omissao.
  deadlinePushReminders  Boolean @default(false)
  // Ao concluir uma task académica (não evento), cria 3 tasks leves de
  // revisão a +1/+3/+7 dias (ver TasksService.spawnFollowUps).
  spacedReviewsEnabled Boolean @default(false)
  // Entradas novas do Notebook nascem escondidas dos amigos com acesso as
  // notas (NotebookEntry.privateFromFriends). Desligado = tudo visivel.
  notesPrivateByDefault Boolean @default(false)

  // 2FA (TOTP, RFC 6238). Só tem efeito com TWO_FACTOR_ENABLED=true no
  // backend; com a flag desligada nada disto é usado nem exposto.
  // - twoFactorSecret: base32 CIFRADO (encryptToken). Preenchido no setup;
  //   o 2FA só conta como ativo quando twoFactorEnabledAt != null (o user
  //   provou que a app autenticadora gera códigos válidos).
  // - twoFactorRecoveryHashes: SHA-256 dos códigos de recuperação (nunca em
  //   claro); cada um gasta-se uma vez.
  // - twoFactorLastStep: último intervalo de 30s aceite - impede reutilizar
  //   o mesmo código (replay).
  twoFactorSecret         String?
  twoFactorEnabledAt      DateTime?
  twoFactorRecoveryHashes String[]
  twoFactorLastStep       Int?

  // Segredo do feed .ics subscrivível (GET /feed/:token.ics). null = feed
  // desligado. Quem tiver este token lê o horário/tasks (só leitura), por
  // isso é gerado com 32 bytes aleatórios e pode ser rodado/revogado a
  // qualquer momento (POST/DELETE /schedule/feed).
  calendarFeedToken String? @unique

  // Relações
  identities       Identity[]
  tasks            Task[]
  apiKeys          ApiKey[]
  securityLogs     SecurityLog[]
  studySessions    StudySession[]
  agentConfig      AgentConfig?
  programs         AcademicProgram[] @relation("UserPrograms")
  classOccurrences ClassOccurrence[]
  workShifts       WorkShift[]
  // Bem-estar (Fase 7): registo diario do estado mental e medicacao.
  moodLogs         MoodLog[]
  medications      Medication[]
  medicationDoses  MedicationDose[]
  medicationIntakes MedicationIntake[]
  // Aviso legal da medicacao aceite (versao e quando). Sem aceitar a versao
  // atual nao se pode adicionar medicamentos nem registar tomas.
  medicationDisclaimerVersion    Int?
  medicationDisclaimerAcceptedAt DateTime?
  // Lingua em que o aviso foi mostrado quando foi aceite (prova do texto lido).
  medicationDisclaimerLocale     String?   @db.VarChar(10)
  taskAttachments  TaskAttachment[]
  // Pads (bloco estilo dontpad) e turmas (Fase 7).
  padEdits            Pad[]               @relation("PadUpdatedBy")
  padsLocked          Pad[]               @relation("PadLockedBy")
  padSourcesBlocked   PadBlockedSource[]  @relation("PadSourceBlockedBy")
  turmasCreated       Turma[]             @relation("TurmaCreatedBy")
  turmaMemberships    TurmaMember[]
  turmaNotesCreated   TurmaNote[]         @relation("TurmaNoteCreatedBy")
  turmaNotesUpdated   TurmaNote[]         @relation("TurmaNoteUpdatedBy")
  turmaFiles          TurmaFile[]
  turmaAnnouncements  TurmaAnnouncement[]
  turmaLinkedAreas    TurmaLinkedArea[]
  commitments      Commitment[]
  travelTimes      TravelTime[]
  calendarSyncedEvents CalendarSyncedEvent[]
  bannedIps        BannedIp[]
  areaScheduleLinks AreaScheduleLink[]
  areaInterests     AreaInterest[]
  notebookEntries   NotebookEntry[]
  notebookShares    NotebookShare[]
  notebookShareAccessRequests NotebookShareAccessRequest[]
  gradeComponents GradeComponent[]
  notebookChangeProposals NotebookChangeProposal[]
}

/// Recurso submetido pelo próprio utilizador contra a sua suspensão/ban
/// (ver AccountBlockedPage no frontend e AppealsService no backend).
/// Alcançável mesmo sem sessão normal - ver JwtBlockedAwareStrategy sobre
/// como um utilizador BANNED/SUSPENDED consegue autenticar-se só para
/// isto, sem desbloquear mais nenhuma rota da app.
model UserAppeal {
  id     String @id @default(uuid())
  userId String
  user   User   @relation("UserAppeals", fields: [userId], references: [id], onDelete: Cascade)

  // Snapshot do status/motivo no momento da submissão - para o pedido
  // continuar a fazer sentido a um admin mesmo que statusReason mude
  // entretanto (ex: segunda ofensa antes de este appeal ser revisto).
  statusAtSubmission UserStatus
  reasonAtSubmission String?
  message            String     @db.Text

  createdAt DateTime @default(now())

  // Tudo null enquanto pendente - AppealsService.create() recusa uma
  // segunda submissão enquanto existir uma com resolvedAt null.
  resolution       AppealResolution?
  resolutionNote   String?
  resolvedAt       DateTime?
  resolvedByUserId String?
  resolvedBy       User?             @relation("UserAppealResolutions", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([resolvedAt])
}


/// Um "dashboard" académico do user (ex: "Secundário", "Licenciatura em
/// Engenharia Informática"). Cada user pode ter vários, para não misturar
/// níveis de ensino/percursos diferentes no mesmo ecrã.
///
/// NOTA: Area continua GLOBAL (catálogo partilhado gerido por admin, ver
/// migrations `make_areas_global` / `remove_user_id_from_areas`) - por
/// isso o scoping por período fica no Task (que já é per-user), e não na
/// Area como uma primeira leitura do modelo "User -> Area -> Task" sugeria.
model AcademicProgram {
  id         String   @id @default(uuid())
  userId     String
  name       String
  gradeScale String   @default("0-20")
  isActive   Boolean  @default(true)
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  // Default for whether the final (credit-weighted) average is rounded to
  // the nearest whole number, e.g. some unis round the semester/course
  // final grade even though individual test grades stay decimal.
  // AcademicPeriod.roundFinalGrade can override this per period; null
  // there means "inherit this default".
  roundFinalGrade Boolean @default(true)

  user           User             @relation("UserPrograms", fields: [userId], references: [id], onDelete: Cascade)
  periods        AcademicPeriod[]
  // Users que têm este programa como dashboard ativo agora - na prática
  // nunca mais do que 1 (o próprio dono), mas o Prisma exige o lado inverso
  // da relação declarado.
  activeForUsers User[]           @relation("UserActiveProgram")

  // userId: ProgramsService.findAllForUser() filtra sempre por dono - é a
  // query mais frequente deste modelo.
  @@index([userId])
}

/// Um período (semestre/ano letivo) dentro de um AcademicProgram. As Tasks
/// passam a apontar para aqui (Task.periodId), nunca para o Program
/// diretamente - o Program é só o agrupador para o seletor no topo do
/// dashboard.
model AcademicPeriod {
  id         String    @id @default(uuid())
  programId  String
  name       String
  startDate  DateTime
  endDate    DateTime?
  isArchived Boolean   @default(false)
  archivedAt DateTime?
  // The period the program should auto-select when you switch to it or
  // reload, instead of always defaulting to the chronologically most
  // recent non-archived one - lets you "stick" to a specific
  // semester/year even if a newer one already exists. At most one pinned
  // period per program (enforced in PeriodsService.pin(), not at the DB
  // level - a partial unique index would need raw SQL in the migration).
  isPinned   Boolean   @default(false)
  createdAt  DateTime  @default(now())
  // Overrides AcademicProgram.roundFinalGrade for this period specifically.
  // null = inherit the program's default (the common case) - only set this
  // when a period genuinely needs to diverge from its program's setting.
  roundFinalGrade Boolean?

  program        AcademicProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  tasks          Task[]
  gradeComponents GradeComponent[]
  activeForUsers User[]          @relation("UserActivePeriod")

  // programId: PeriodsService.findAllForProgram() always filters by
  // program - same indexing logic as the rest of the app.
  @@index([programId])
}

model ApiKey {
  id        String      @id @default(uuid())
  userId    String
  keyHash   String      @unique
  name      String
  // Defaults to TASKS so every pre-existing key (including whatever the
  // agent already has embedded) keeps exactly its current, narrower
  // access after this migration - nothing is silently upgraded.
  scope     ApiKeyScope @default(TASKS)
  createdAt DateTime    @default(now())
  lastUsed  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // userId nunca é indexado automaticamente só por ser FK - exportUserData()
  // (users.service.ts) faz findMany({ where: { userId } }) para listar as
  // keys de uma pessoa, sem isto seria sempre um scan à tabela toda.
  @@index([userId])
}

/// Configuração do pmaxing-agent (Fase 5) - uma por user. O agente local
/// vai buscar isto a GET /agent/config a cada ciclo de polling, autenticado
/// com a mesma API key de sempre, para poder ser editado dinamicamente na
/// app sem precisar de tocar em nenhum ficheiro na máquina de quem o corre.
model AgentConfig {
  id     String @id @default(uuid())
  userId String @unique

  // Ver AgentTriggerMode acima.
  triggerMode AgentTriggerMode @default(ANY)

  // Ativa se existir qualquer task com data anterior a hoje e
  // progressStatus != COMPLETED - ignora lastOverdueCheckAt de propósito,
  // para não depender de teres respondido ao popup de check-in.
  hasOverdueTasks Boolean @default(true)

  // Ativa se GET /tasks/overdue-checkins devolver alguma task por
  // confirmar hoje (semântica "uma vez por dia", ver o service).
  hasOverdueCheckins Boolean @default(false)

  // Se definido, ativa quando existir uma task hoje com esta dificuldade
  // ou mais. Null desativa esta regra.
  minDifficultyToday Difficulty?

  // Ativa sempre que houver qualquer task pendente hoje.
  anyTaskToday Boolean @default(false)

  // Ativa enquanto houver uma sessao de Focus a decorrer (StudySession sem
  // endedAt): o agente bloqueia as distracoes so durante o estudo. O agente
  // consulta GET /agent/config/focus quando isto esta ligado.
  blockDuringFocus Boolean @default(false)

  // Se definido, ativa quando existir qualquer task não-completada com
  // progressStatus igual ou pior do que este (BEHIND < VERY_BEHIND).
  // Null desativa esta regra.
  minProgressStatus ProgressStatus?

  // O que bloquear quando as regras acima decidirem que deve bloquear.
  blockedProcesses String[] @default([])
  blockedDomains   String[] @default([])

  // O que o agente faz se não conseguir contactar a API.
  failMode AgentFailMode @default(CLOSED)

  // Cada quantos segundos o agente deve voltar a consultar a API.
  pollIntervalSeconds Int @default(60)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}


model Identity {
  id                String    @id @default(uuid())
  calendarId String?
  userId            String
  provider          Provider
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  scope             String?
  createdAt         DateTime  @default(now())

  // Relações
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Garante que o mesmo providerAccount não é associado duas vezes
  @@unique([provider, providerAccountId])
  // userId sozinho (sem o provider) é usado em getProviders(),
  // getDecryptedProviderTokens() e no cascade delete de User - o
  // @@unique acima não serve para essas queries porque começa por
  // "provider", não por "userId".
  @@index([userId])
}

/// Abstração que representa um "Balde" ou "Área de Vida".
model Area {
  // Cadeiras que membros publicaram numa turma (ver TurmaLinkedArea).
  turmaLinks TurmaLinkedArea[]
  id       String @id @default(uuid())
  name     String
  colorHex String @default("#808080")

  // Opcional: liga esta Area a um TaskType por omissão (ex: "CDR" -> Académico,
  // "Natação" fica null). Quando definido, o frontend pré-seleciona e tranca o
  // Type ao criar uma task nesta Area, e esconde os campos só-académicos
  // (nota, peso) para Areas sem tipo associado.
  defaultTaskTypeId String?
  defaultTaskType   TaskType? @relation("AreaDefaultTaskType", fields: [defaultTaskTypeId], references: [id])

  // ECTS credits (or equivalent) for the course, optional - only makes
  // sense for university-level programs. Null = no credits set (e.g.
  // secondary school, or a non-academic Area like "Swimming"). Used as
  // the weight for level 2 of the average calculation (per-Area average
  // -> period/program average), see grade-average.util.ts. Lives on Area
  // (global catalog) and not on AcademicProgram/AcademicPeriod because
  // it's a property of the course itself, not of a user's dashboard -
  // same "Area stays global" logic as the rest of the model (see the
  // note on AcademicProgram above).
  credits Int?

  // Oficial vs privada. ownerId = null -> Area OFICIAL (catálogo global,
  // gerido só por admins, visível a todos). ownerId != null -> Area PRIVADA
  // desse user: só ele a vê, usa e edita. Uma privada pode ser proposta
  // (proposalStatus) e, se um admin aprovar, passa a ownerId = null.
  // onDelete: Cascade - apagar a conta apaga as Areas privadas (as tasks
  // do user são apagadas antes, ver AuthService.deleteAccount, porque
  // Task.area é Restrict).
  ownerId String?
  owner   User?   @relation("UserOwnedAreas", fields: [ownerId], references: [id], onDelete: Cascade)

  proposalStatus     AreaProposalStatus @default(NONE)
  proposedAt         DateTime?
  // Motivo da recusa, escrito pelo admin e visível só ao dono.
  proposalReviewNote String?

  @@index([ownerId])
  @@index([proposalStatus])

  hiddenBy AreaHidden[]

  // Relações
  tasks         Task[]
  studySessions StudySession[]
  // Ligação por user a um texto de disciplina do horário (ver
  // AreaScheduleLink) e as entradas do caderno desta cadeira.
  scheduleLinks   AreaScheduleLink[]
  interests       AreaInterest[]
  notebookEntries NotebookEntry[]
  gradeComponents GradeComponent[]
}

/// Representa uma ação executável dentro de uma Área (Area).
model Task {
  id     String   @id @default(uuid())
  userId String
  areaId String
  title  String
  date   DateTime

  // Pinned tasks surface first everywhere the task list is sorted (see
  // TaskGrid.tsx/TasksTable.tsx on the frontend) - a lightweight
  // "keep this one visible" override independent of date/status/
  // difficulty, for whatever the user is actively keeping an eye on.
  isPinned Boolean @default(false)

  // Ordem manual (drag-and-drop no TaskGrid) - menor primeiro. Uma task
  // nova entra sempre no fim (ver TasksService.create: max atual + 1),
  // nunca a 0, para não saltar para o topo da lista de alguém sem ter
  // sido arrastada para lá. findAll() ordena por isto antes de `date`;
  // PATCH /tasks/reorder é o único sítio que muda isto (ver
  // TasksService.reorder).
  sortOrder Int @default(0)

  // Tipologia e Categorização
  taskTypeId     String
  taskType       TaskType          @relation(fields: [taskTypeId], references: [id])
  academicTypeId String?
  academicType   AcademicTaskType? @relation(fields: [academicTypeId], references: [id])
  topics         String?

  // Notas livres/journaling sobre a task - reflexão pós-conclusão, o que
  // correu bem/mal num exame, contexto que não cabe no título nem nos
  // topics. Sem limite de tamanho a nível de schema (@db.Text em vez do
  // varchar por omissão) porque isto é, por natureza, para escrever à
  // vontade - o limite prático fica só no DTO (ver CreateTaskDto), não
  // aqui.
  notes String? @db.Text

  // A que período (semestre/ano letivo, dentro de um AcademicProgram) esta
  // task pertence. Obrigatório - toda a task nova tem sempre um período
  // (a app resolve o período ativo do user como default quando o
  // frontend/cliente da API não o envia explicitamente, ver
  // TasksService.create). Nunca aponta diretamente para Area porque essa
  // continua global/partilhada entre users.
  periodId String?
  period   AcademicPeriod? @relation(fields: [periodId], references: [id])

  // Metadados de Execução
  weightPercentage Float?
  difficulty       Difficulty
  // Opcional (como academicTypeId, não como taskTypeId) de propósito: uma
  // migração que tornasse isto obrigatório exigiria dar um valor a toda a
  // task já existente na BD antes de aplicar a constraint NOT NULL - mais
  // uma migração distinta, teria de correr depois do seed de Priority
  // (prisma/scripts/seed-priorities.ts) já ter inserido pelo menos uma
  // linha para apontar. Ficar opcional evita essa dependência de ordem;
  // pode-se apertar para obrigatório mais tarde, já com o catálogo
  // semeado e todas as tasks com um valor real.
  priorityId       String?
  priority         Priority?      @relation(fields: [priorityId], references: [id])
  // Incrementado no backend (tasks.service.ts update()) sempre que a data
  // muda para um valor MAIS TARDE que a anterior - conta qualquer forma de
  // adiar (o botão rápido "+1 Day" e uma edição manual da data no form),
  // não só um caminho específico. Nunca decresce, mesmo que a task seja
  // adiantada de novo - é uma contagem histórica de "quantas vezes isto já
  // foi empurrado", não um estado atual.
  postponedCount   Int            @default(0)
  progressStatus   ProgressStatus @default(ON_TRACK)
  referenceLink    String?

  // Ver enums Effort e DateCertainty acima.
  effort        Effort?
  dateCertainty DateCertainty @default(EXACT)

  // Task que ainda nao da para comecar (o enunciado ainda nao saiu, a
  // materia ainda nao foi dada). availableFrom = dia em que abre; isBlocked
  // sem data = bloqueada ate o user a desbloquear. Enquanto bloqueada fica
  // fora do plano de estudo, dos atrasos e das regras do agente.
  isBlocked     Boolean   @default(false)
  availableFrom DateTime?

  // Task importada de um pacote (ver TaskPack): de que item veio e que
  // versao desse item ja tem aplicada. Quando o dono do pacote o atualiza,
  // nasce um TaskPackUpdate por task importada, que o user aceita ou recusa;
  // nunca se muda a task sem autorizacao.
  packItemId      String?
  packItem        TaskPackItem? @relation("ImportedFromPackItem", fields: [packItemId], references: [id], onDelete: SetNull)
  packItemVersion Int?
  // Itens de pacotes criados a partir desta task (lado do dono).
  sourceOfPackItems TaskPackItem[] @relation("PackItemSource")
  packUpdates       TaskPackUpdate[]

  // Duração esperada em minutos, escrita manualmente pelo user ao criar/
  // editar a task. Distinto de calendarDurationMinutes (esse só serve o
  // bloco do evento no Google Calendar); este é o "quanto tempo acho que
  // isto vai levar" que alimenta a feature de previsão de duração - é o
  // par (estimativa manual, tempo real via StudySession.taskId) usado
  // como dados de treino em PredictionService. Null para tasks antigas
  // criadas antes deste campo existir.
  estimatedMinutes Int?

  // Tempo de estudo APROXIMADO, escrito de memória, para avaliações antigas
  // feitas antes de haver sessões registadas. So conta quando a task nao
  // tem nenhuma sessao terminada (as sessoes reais ganham sempre). Existe
  // para as previsoes (duracao, calibracao, projecao de notas) poderem
  // aprender com o historico que ja tens em vez de esperarem por meses de
  // sessoes novas.
  recalledStudyMinutes Int?

  // Avaliação (Relevante para contexto Académico/Trabalho)
  targetGrade Float?
  realGrade   Float?

  completedAt DateTime?

  // Última vez que perguntámos ao user se esta task (já fora de prazo) está
  // feita ou não (feature de "overdue check-in", ver tasks.service.ts).
  // Serve só para não repetir a pergunta várias vezes no mesmo dia - a
  // pergunta volta a aparecer no dia seguinte enquanto a task não passar a
  // COMPLETED. Não precisa de índice: é sempre lido junto com o filtro por
  // userId + date, que já cobre a query.
  lastOverdueCheckAt DateTime?

  // Integrações
  googleCalendarEventId String?
  // Duração em minutos do evento no Google Calendar, só relevante quando a
  // Task tem hora definida (evento "dia inteiro" ignora isto). Null =
  // continua a usar o default de 60min no CalendarService, para tasks
  // antigas criadas antes deste campo existir.
  calendarDurationMinutes Int?
  createdAt             DateTime @default(now())
  // Gerido automaticamente pelo Prisma (@updatedAt - toca em qualquer
  // update(), não só os campos "visíveis"). Alimenta o StaleTasksCard
  // no frontend ("esta task está pendente há muito tempo sem ninguém
  // lhe tocar") - sem isto não havia sinal nenhum de "última atividade"
  // numa task, só "quando foi criada" (createdAt), que não é a mesma
  // pergunta.
  updatedAt DateTime @updatedAt

  // Relações
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  area Area @relation(fields: [areaId], references: [id])
  studySessions StudySession[]
  // Recorrência: ao CONCLUIR esta task cria-se a próxima ocorrência
  // (TasksService.spawnFollowUps). null = não repete.
  recurrenceFrequency RecurrenceFrequency?
  // A cada N dias/semanas/meses (>= 1).
  recurrenceInterval  Int                 @default(1)
  // Última data (inclusive) em que ainda se cria ocorrência; null = sem fim.
  recurrenceUntil     DateTime?

  // Se esta task é uma revisão espaçada, id da task que a originou. Nunca
  // gera novas revisões (evita cadeias) e serve de chave para não duplicar.
  spacedReviewOfTaskId String?

  // Checklist leve da task (ver model Subtask) - sem peso, sem nota, não
  // entra em nenhuma média nem previsão.
  subtasks Subtask[]
  sentReminders SentReminder[]
  // Ficheiros da task (enunciado em PDF, etc.), ver model TaskAttachment.
  attachments TaskAttachment[]

  // Nenhuma destas é indexada automaticamente só por ser FK no Postgres:
  // - userId: TasksService.findAll/findOne/update/remove filtram sempre
  //   por ele (where: { userId, ... }) - é a query mais frequente de
  //   toda a app, sem índice degrada para scan completo à tabela Task
  //   à medida que ela cresce.
  // - areaId / taskTypeId / academicTypeId: sem índice, apagar uma Area
  //   ou um TaskType obriga o Postgres a percorrer a tabela Task inteira
  //   só para verificar se a FK constraint permite o apagar.
  // - periodId: dashboard filtra tasks por período ativo constantemente
  //   (?periodId= nos endpoints existentes, fase 2) - mesma lógica dos
  //   índices acima, sem isto degrada para scan à medida que a tabela cresce.
  @@index([userId])
  @@index([packItemId])
  @@index([spacedReviewOfTaskId])
  @@index([areaId])
  @@index([taskTypeId])
  @@index([academicTypeId])
  @@index([periodId])
  // findAll() ordena por [sortOrder, date] dentro de userId+periodId - sem
  // isto, o mesmo raciocínio dos índices acima aplica-se ao ORDER BY.
  @@index([userId, sortOrder])
  // "Hoje", Dashboard e atrasadas filtram userId + intervalo de date.
  @@index([userId, date])
  // O cron de lembretes (RemindersService) procura por intervalo de date em
  // todos os users.
  @@index([date])
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

/// Lembrete por email já enviado: uma linha por (task, data-limite). Se a
/// data da task mudar, a chave muda e o lembrete pode voltar a sair; se o
/// cron correr duas vezes, o unique impede o email duplicado.
model SentReminder {
  id        String   @id @default(uuid())
  taskId    String
  // Prazo da task no momento do envio.
  taskDate  DateTime
  sentAt    DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, taskDate])
}

/// Item de checklist dentro de uma Task. Propositadamente MUITO mais simples
/// que uma Task: só título + feito/não feito. Sem peso, sem nota, sem
/// dificuldade, sem data - por isso não conta para médias, previsões nem
/// plano de estudo. Serve para os passos pequenos que não justificam uma
/// Task própria (nem entram bem num Area "secundária" sem peso).
/// Apagar a Task apaga as subtasks (cascade).
model Subtask {
  id          String    @id @default(uuid())
  taskId      String
  title       String
  isDone      Boolean   @default(false)
  // Ordem manual dentro da task (menor primeiro); novas entram no fim.
  sortOrder   Int       @default(0)
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  // Toda a leitura é "as subtasks desta task, por ordem".
  @@index([taskId, sortOrder])
}

/// Registo persistente de eventos de segurança - hoje só bloqueios do
/// ThrottlerGuard (candidatos a tentativa de DoS/força bruta), escrito por
/// LoggingThrottlerGuard sempre que um IP excede o limite de pedidos.
/// Distinto do RequestUserLoggerInterceptor (esse só imprime no terminal,
/// não fica gravado - some com o restart do dyno do Render).
/// Ficheiro anexado a uma task (ex: enunciado em PDF). Mesmo bucket privado
/// e mesma validacao dos anexos do Notebook (attachment-validation.util.ts),
/// numa pasta propria (tasks/<userId>/). userId repetido aqui (e nao so via
/// a task) para todas as queries filtrarem pelo dono diretamente.
/// Apagar a task apaga as linhas (cascade); o ficheiro no storage e apagado
/// antes pelo TaskAttachmentsService.
model TaskAttachment {
  id               String @id @default(uuid())
  taskId           String
  userId           String
  storagePath      String
  originalFileName String
  extension        String
  sizeBytes        Int

  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([userId])
}

model SecurityLog {
  id        String            @id @default(uuid())
  type      SecurityEventType @default(RATE_LIMIT_EXCEEDED)
  ip        String
  method    String
  path      String
  userAgent String?
  count     Int               @default(1) // quantos bloqueios agregados nesta linha (ver LoggingThrottlerGuard)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @default(now()) @updatedAt

  // A maioria dos bloqueios acontece SEM sessão (é precisamente o padrão
  // de um ataque), por isso opcional. Se o attacker tiver sessão válida
  // (ex: script autenticado a martelar um endpoint), guardamos quem é -
  // mas nunca apagamos o log só porque a conta foi apagada depois.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // ip: a query mais comum do admin é "o que fez este IP" / agrupar por IP
  // para o ranking de piores ofensores.
  // createdAt: listagem é sempre ordenada e filtrada por período recente -
  // sem índice degrada para scan completo à medida que a tabela cresce.
  @@index([ip])
  @@index([createdAt])
  @@index([userId])
}

/// IP banido manualmente por um admin (ver /admin/banned-ips e
/// BannedIpGuard). Separado de SecurityLog de propósito: SecurityLog é só
/// telemetria (o que aconteceu), isto é a decisão em si (o que fazer a
/// partir de agora) - um IP pode ter zero SecurityLogs e ainda assim ser
/// banido preventivamente, e um ban não apaga o histórico de logs que já
/// existia.
model BannedIp {
  id        String   @id @default(uuid())
  ip        String   @unique
  reason    String?
  createdAt DateTime @default(now())

  // Quem baniu - opcional pelo mesmo motivo do SecurityLog.userId: nunca
  // se apaga o ban só porque a conta do admin que o criou foi apagada
  // depois.
  bannedByUserId String?
  bannedBy       User?   @relation(fields: [bannedByUserId], references: [id], onDelete: SetNull)
  // Sem @@index([ip]): o @unique ja cria esse indice (um segundo so pesava
  // nas escritas).
}

/// Uma sessão de estudo/foco: início, fim (null enquanto está a decorrer),
/// opcionalmente ligada a uma Task ou Area, com nota livre. Usada pela
/// página Focus para: (1) o widget de sessão ativa, (2) o heatmap de
/// melhores horas para estudar, (3) histórico.
model StudySession {
  id        String    @id @default(uuid())
  userId    String
  startedAt DateTime  @default(now())
  // null enquanto a sessão está a decorrer - é o que StudySessionsService
  // usa para saber se há uma sessão "ativa" (no máximo 1 por utilizador).
  endedAt   DateTime?
  // Atualizado periodicamente pelo frontend enquanto a sessão está ativa
  // (ver StudySessionProvider.tsx, POST /study-sessions/:id/heartbeat) -
  // é o sinal que StudySessionsService.autoCloseIfStale usa para saber
  // se uma sessão "ativa" ainda está mesmo a decorrer, ou se ficou
  // esquecida (separador fechado sem o pagehide disparar, portátil foi
  // a baixo, etc.) e deve ser fechada sozinha em vez de continuar a
  // contar horas fantasma até o utilizador reparar. null até ao
  // primeiro heartbeat (mesmo instante do start(), na prática).
  lastHeartbeatAt DateTime?
  note      String?

  // Concentracao percebida, 1 (dispersa) a 5 (totalmente focada), dada ao
  // parar. Opcional: quem nao responder nao perde nada.
  focusRating Int?

  // True quando a sessao foi escrita depois (esqueci-me de a ligar), em vez
  // de cronometrada. Serve para a mostrar como tal no historico.
  isManual Boolean @default(false)

  // Quantas vezes o user carregou em "Got distracted" durante a sessao.
  // Notar a distracao (em vez de lhe obedecer) ajuda a voltar ao trabalho,
  // e o total por sessao mostra quando/onde te distrais mais.
  distractionCount Int @default(0)

  createdAt DateTime  @default(now())

  // Opcionais e independentes um do outro: dá para começar uma sessão sem
  // apontar a task/area nenhuma ("estudo genérico"), só a uma Area (ex:
  // "Networking" em geral), só a uma Task, ou às duas.
  taskId String?
  areaId String?

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  // onDelete: SetNull - apagar uma Task/Area não deve apagar o histórico
  // de sessões de estudo já registadas, só desassociar.
  task Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  area Area? @relation(fields: [areaId], references: [id], onDelete: SetNull)

  // userId: toda a gente das queries (ativa, heatmap, histórico) filtra
  // sempre por dono - é a query mais frequente deste modelo.
  // [userId, startedAt]: o heatmap e o histórico ordenam/filtram sempre
  // por período dentro do próprio utilizador.
  @@index([userId])
  @@index([userId, startedAt])
  @@index([taskId])
  @@index([areaId])
}

/// Uma aula concreta, numa data concreta - importada do .ics do horário
/// publicado pela faculdade (ver ScheduleService.importOccurrences).
///
/// DELIBERADAMENTE não existe um "modelo recorrente com exceções"
/// (weekday + RRULE + EXDATE): o .ics real da Maiêutica não usa RRULE nem
/// EXDATE nenhum, é uma lista plana de um VEVENT por aula por semana, numa
/// janela curta (~2-3 semanas de cada vez, não o semestre todo). Tentar
/// inferir "isto mudou só esta semana" vs "isto mudou para sempre" a partir
/// disto seria adivinhar - em vez disso, isto reflete exatamente o que o
/// ficheiro diz em cada reimportação. A vista semanal e o cálculo de tempo
/// livre do StudyPlanService leem sempre as ocorrências reais mais
/// recentes, nunca um "molde" semanal guardado à parte - se a faculdade
/// mudar uma aula (pontual ou definitivamente), a próxima reimportação já
/// reflete isso sem precisar de nenhuma migração de dados.
model ClassOccurrence {
  id     String @id @default(uuid())
  userId String

  // Dia da aula (meia-noite UTC desse dia, hora de Lisboa) - startMinutes/
  // endMinutes é que guardam a hora exata, não isto. Sempre calculado a
  // partir do DTSTART do .ics já convertido para hora local de Lisboa
  // (ver toLisbonWallClock() em schedule.service.ts) - nunca a data UTC
  // crua, que podia cair no dia errado perto da meia-noite.
  date         DateTime
  startMinutes Int
  endMinutes   Int

  subject   String
  location  String?
  professor String?

  // Chave natural do VEVENT original (campo UID do .ics). Garante que
  // reimportar o mesmo ficheiro, ou uma janela nova que sobrepõe a
  // anterior, faz upsert em vez de duplicar linhas - ver
  // ScheduleService.importOccurrences (upsert por [userId, externalUid]).
  externalUid String

  // Presença: null = por marcar, true = fui, false = faltei. Marcada à mão
  // na vista semanal do Schedule, ou sozinha (true) quando se cria uma
  // entrada do caderno a partir desta aula. Reimportar o .ics não lhe toca
  // (o update do upsert em importOccurrences não inclui este campo).
  attended Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Entradas do caderno criadas a partir desta aula específica (ver
  // NotebookEntry.classOccurrenceId) - SetNull lá, não Cascade: apagar a
  // ocorrência (ex: reimport que já não a inclui) nunca deve apagar o
  // apontamento que o utilizador escreveu durante essa aula.
  notebookEntries NotebookEntry[]

  // userId: toda a query (vista semanal, cálculo de slots livres do plano
  // de estudo) filtra sempre por dono - mesma lógica de indexação do
  // resto do schema.
  // [userId, date]: a vista semanal e o StudyPlanService filtram sempre
  // por intervalo de datas dentro do próprio user.
  // [userId, externalUid]: chave de upsert do import - tem de ser única
  // para o upsert nunca duplicar uma ocorrência já importada antes.
  @@unique([userId, externalUid])
  @@index([userId])
  @@index([userId, date])
}

/// Liga, por user, um texto literal de disciplina tal como aparece no
/// .ics importado (ex: "PC", "Prog. Computadores") a uma Area (cadeira)
/// do catálogo global. Necessário porque Area é global/partilhada (ver
/// nota em AcademicProgram) mas o texto do horário varia por
/// user/faculdade/semestre - sem esta tabela não há como saber que "PC"
/// no teu horário é a mesma cadeira que a tua Area "Programação e
/// Computadores". Usada só pelo NotebookService para sugerir
/// automaticamente o título de uma entrada nova quando há aula agora.
model AreaScheduleLink {
  id              String @id @default(uuid())
  userId          String
  areaId          String
  scheduleSubject String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  area Area @relation(fields: [areaId], references: [id], onDelete: Cascade)

  // Um mesmo texto de disciplina do horário só pode apontar para UMA Area
  // por user (evita ambiguidade no match "aula agora"). Uma Area pode ter
  // vários scheduleSubject diferentes ligados (ex: "PC" e "Prog. Comp."
  // em semestres diferentes, mesma cadeira).
  @@unique([userId, scheduleSubject])
  @@index([userId, areaId])
}

/// Quanto interesse o user tem numa cadeira (1 a 5). Por user e nao uma
/// coluna em Area porque Area e global/partilhada: o interesse e pessoal.
/// Usado so para medir, nos dados da propria pessoa, quanto o (des)interesse
/// pesa na nota (ver FocusEffectService).
model AreaInterest {
  id     String @id @default(uuid())
  userId String
  areaId String
  rating Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  area Area @relation(fields: [areaId], references: [id], onDelete: Cascade)

  // Um interesse por cadeira por user.
  @@unique([userId, areaId])
  @@index([areaId])
}

/// Uma entrada do "caderno" de uma cadeira: texto, desenho à mão
/// (drawingStrokes, vetorial - ver NotebookService/NotebookCanvas no
/// frontend) e fotos (NotebookPhoto), tudo na mesma página, como um
/// caderno físico real. classOccurrenceId liga a entrada à aula
/// detetada automaticamente (ver AreaScheduleLink) quando existe match
/// na hora de criação; fica null quando o utilizador cria a entrada sem
/// estar dentro do horário de nenhuma aula dessa cadeira.
model NotebookEntry {
  id                String @id @default(uuid())
  userId            String
  areaId            String
  classOccurrenceId String?

  title       String
  textContent String?

  // Preso a código de propósito (mesma lógica do AuthProvider mais acima):
  // só CLASS liga à sugestão automática de classNumber incremental, não
  // faz sentido ser um catálogo editável pelo admin.
  entryType NotebookEntryType @default(NOTE)
  // Só relevante quando entryType = CLASS. Guardado como campo próprio
  // (não extraído do título por regex) precisamente para a sugestão de
  // "próxima aula" ser robusta - ver NotebookEntry no frontend
  // (nextClassNumber = maior classNumber já usado nesta Area + 1). Duas
  // entradas CLASS podem ter o mesmo número de propósito (ex: a mesma
  // aula deu para duas cadeiras diferentes e o utilizador quis duas
  // entradas separadas) - por isso não há unique constraint aqui.
  classNumber Int?

  // Traços vetoriais do desenho à mão, não um PNG rasterizado - permite
  // reabrir a entrada e continuar a desenhar/apagar um traço específico.
  // Formato: [{ points: [{x,y,pressure?}], color, width }].
  drawingStrokes Json?

  // Tabelas estruturadas (linhas x colunas de texto), separadas de
  // textContent de propósito - um <table> real editável na UI em vez de
  // pipes Markdown escritos à mão dentro do textarea (ilegível a olho
  // nu). Formato: [{ id, rows: string[][] }]. Ver upsert-notebook-entry.dto.ts
  // para os limites de tamanho (NotebookTableDto/NotebookTableRowDto).
  tables Json?

  // Ícones posicionáveis no canvas (router/switch/firewall/...) - ao
  // contrário de drawingStrokes (traço à mão, imutável), isto guarda
  // posição/tamanho próprios que o frontend deixa arrastar/redimensionar
  // depois de colocados. Formato: [{ id, type, x, y, width, height, label }].
  // Ver CanvasShapeDto em upsert-notebook-entry.dto.ts.
  canvasShapes Json?

  // Ligações entre duas formas de canvasShapes (por id) - sem coordenadas
  // próprias, o frontend recalcula o traço da linha a partir da posição
  // atual das duas formas a cada render, por isso "segue" quando uma
  // forma é arrastada. Formato: [{ id, fromShapeId, toShapeId, label }].
  // Ver CanvasLinkDto em upsert-notebook-entry.dto.ts.
  canvasLinks Json?

  // Etiquetas de texto soltas no canvas (não presas a uma forma) - texto
  // livre escrito com o teclado por cima do desenho. Formato:
  // [{ id, x, y, text }]. Ver CanvasTextDto em upsert-notebook-entry.dto.ts.
  canvasTexts Json?

  // Links úteis por entrada (não um campo de notas de texto livre) -
  // para não os ter de meter no meio do textContent. Formato:
  // [{ id, label, url }]. Ver UsefulLinkDto em upsert-notebook-entry.dto.ts.
  usefulLinks Json?

  // Altura do viewBox do whiteboard (largura fica sempre fixa em 800) -
  // null = usa o default do frontend. Extensível pelo botão "Add more
  // space" no NotebookCanvas, para quem fica sem espaço no desenho sem
  // ter de criar uma segunda entrada só para continuar a aula.
  canvasHeight Int?

  // Escondida dos amigos com acesso as notas desta cadeira (NotebookViewGrant).
  // Nao mexe nos links de partilha nem nos convites: esses sao por entrada e
  // o dono escolhe-os de proposito. Valor inicial vem de
  // User.notesPrivateByDefault.
  privateFromFriends Boolean @default(false)

  // Editável pelo utilizador (não é createdAt) - de propósito, para
  // conseguir meter apontamentos antigos no sítio certo da ordem
  // cronológica em vez de tudo cair na data em que foi digitalizado.
  date DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  area            Area             @relation(fields: [areaId], references: [id], onDelete: Cascade)
  classOccurrence ClassOccurrence? @relation(fields: [classOccurrenceId], references: [id], onDelete: SetNull)
  photos          NotebookPhoto[]
  attachments     NotebookAttachment[]
  share           NotebookShare?

  @@index([userId, areaId, date])
  changeProposals NotebookChangeProposal[]
}

// Link de partilha "só de leitura" para uma lesson (NotebookEntry) - uma
// linha por entrada (@unique em notebookEntryId), criada a pedido do
// dono via POST /notebook/entries/:id/share e removida via DELETE no
// mesmo endpoint (deixar de partilhar = apagar a linha, não um soft
// revoke - simples e sem estado extra para gerir). O token é o único
// "segredo": GET /notebook/shared/:token não passa por JwtAuthGuard
// nenhum, é a única credencial de quem recebe o link.
model NotebookShare {
  id              String   @id @default(uuid())
  notebookEntryId String   @unique
  token           String   @unique @default(uuid())
  createdByUserId String
  createdAt       DateTime @default(now())
  // PUBLIC (default, comportamento original: o token sozinho já chega) ou
  // AUTHORIZED - nesse caso quem abre o link tem de ter sessão E um
  // NotebookShareAccessRequest com status APPROVED. Campo no share, não
  // na entry: é sobre COMO o link se comporta, não sobre o conteúdo em
  // si, e um dia a mesma entry pode voltar a ser partilhada de outra
  // forma sem isto arrastar histórico antigo.
  visibility NotebookShareVisibility @default(PUBLIC)

  notebookEntry  NotebookEntry                @relation(fields: [notebookEntryId], references: [id], onDelete: Cascade)
  createdBy      User                         @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  accessRequests NotebookShareAccessRequest[]
  visits         ShareVisit[]
  // Sem @@index([token]): o @unique de token ja e o indice.
  // "As minhas partilhas" e "Partilhado comigo" filtram pelo dono.
  @@index([createdByUserId])
}

enum NotebookShareVisibility {
  PUBLIC
  AUTHORIZED
}

// Um pedido de acesso de uma pessoa autenticada a um NotebookShare
// AUTHORIZED. Uma linha por (share, requestingUser) - @@unique abaixo -
// para pedir de novo ser um upsert idempotente (ver
// NotebookService.requestAccess) em vez de acumular pedidos duplicados
// de quem carrega no botão mais do que uma vez.
model NotebookShareAccessRequest {
  id               String                    @id @default(uuid())
  notebookShareId  String
  requestingUserId String
  status           ShareAccessRequestStatus  @default(PENDING)
  // Papel dado quando o dono aprova: VIEWER so le, EDITOR propoe alteracoes
  // que o dono aprova/recusa, CO_OWNER edita direto. So faz sentido em
  // partilhas AUTHORIZED (e preciso saber QUEM e a pessoa).
  accessRole       ShareAccessRole           @default(VIEWER)
  // true = convite do DONO a um amigo (PENDING = a espera de o convidado
  // aceitar, nao de o dono decidir). Estes acessos sao re-verificados a cada
  // leitura: se deixarem de ser amigos, o acesso corta logo.
  invitedByOwner   Boolean                   @default(false)
  createdAt        DateTime                  @default(now())
  // Preenchido quando o dono aprova/nega - fica null enquanto PENDING.
  decidedAt        DateTime?

  notebookShare  NotebookShare @relation(fields: [notebookShareId], references: [id], onDelete: Cascade)
  requestingUser User          @relation(fields: [requestingUserId], references: [id], onDelete: Cascade)

  @@unique([notebookShareId, requestingUserId])
  @@index([notebookShareId, status])
  // "Partilhado comigo" e o contador do Social procuram por quem pediu.
  @@index([requestingUserId, status])
}

enum ShareAccessRequestStatus {
  PENDING
  APPROVED
  DENIED
}

enum NotebookEntryType {
  NOTE
  STUDY
  CLASS
}

/// Uma foto anexada a uma NotebookEntry. Guarda só o caminho no bucket
/// privado do Supabase Storage (nunca base64 na base de dados, nunca um
/// URL público - são apontamentos pessoais, não avatares) - o backend
/// gera um signed URL de curta duração sempre que a entrada é lida (ver
/// NotebookService.attachSignedUrls).
model NotebookPhoto {
  id              String @id @default(uuid())
  notebookEntryId String
  storagePath     String
  position        Int    @default(0)

  createdAt DateTime @default(now())

  notebookEntry NotebookEntry @relation(fields: [notebookEntryId], references: [id], onDelete: Cascade)

  @@index([notebookEntryId])
}

// Ficheiros gerais anexados a uma entrada (PDF, DOCX/PPTX/XLSX, ZIP,
// código/texto: PY/TXT/MD/JSON/CSV) - bucket próprio, separado das fotos
// (nunca público, sempre via signed URL forçado a download - ver
// ATTACHMENT_BUCKET/addAttachment em notebook.service.ts). originalFileName
// é só para mostrar/descarregar; storagePath é sempre um UUID gerado no
// servidor, nunca derivado do nome que o utilizador mandou.
model NotebookAttachment {
  id               String @id @default(uuid())
  notebookEntryId  String
  storagePath      String
  originalFileName String
  extension        String
  sizeBytes        Int

  createdAt DateTime @default(now())

  notebookEntry NotebookEntry @relation(fields: [notebookEntryId], references: [id], onDelete: Cascade)

  @@index([notebookEntryId])
}

/// Turno de trabalho / compromisso fixo (trabalho, ginásio, extra) inserido
/// manualmente. Ou é semanal (dayOfWeek preenchido, date null) ou pontual
/// (date preenchido, dayOfWeek null) - exatamente um dos dois, validado em
/// WorkShiftsService.assertValidShift porque o Prisma não expressa isto.
/// Tempo ocupado no cálculo de tempo livre do plano de estudo, com
/// bufferMinutes de viagem/preparação de cada lado.
model WorkShift {
  id     String @id @default(uuid())
  userId String

  // Local/compromisso a que o turno pertence (ex: "McDonald's"). Nome e
  // tempo de deslocação vêm daí. null = turno solto, criado antes de
  // existirem Commitments: continua a funcionar com label/bufferMinutes.
  commitmentId String?

  // 0=Domingo..6=Sábado (mesma convenção de getUTCDay()).
  dayOfWeek Int?
  // Meia-noite UTC desse dia (hora de Lisboa), como ClassOccurrence.date.
  date      DateTime?
  // So turnos semanais: primeiro dia em que o turno conta (ex.: comecar o
  // trabalho daqui a duas semanas). null = desde sempre (turnos antigos).
  startsOn  DateTime?

  startMinutes  Int
  endMinutes    Int
  bufferMinutes Int    @default(0)
  label         String?
  // Morada e meio de transporte de um evento pontual (sem local). Servem
  // para calcular a viagem casa-evento e entre o evento e o resto do dia
  // (ItineraryService). Turnos de um local usam a morada do local.
  address       String?      @db.VarChar(300)
  commuteMode   CommuteMode?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  commitment Commitment? @relation(fields: [commitmentId], references: [id], onDelete: Cascade)

  // Toda a query filtra por dono; [userId, date] serve os turnos pontuais
  // dentro de um intervalo.
  @@index([userId])
  @@index([userId, date])
  @@index([commitmentId])
}

/// Evento que ESTA app criou no Google Calendar (aulas, turnos, viagens,
/// blocos de estudo). Só estes são atualizados/apagados num sync, nunca os
/// eventos pessoais. sourceKey é a identidade estável (ex: "class:<id>"),
/// contentHash deteta se o conteúdo mudou desde o último envio.
model CalendarSyncedEvent {
  id            String @id @default(uuid())
  userId        String
  sourceKey     String
  googleEventId String
  contentHash   String

  // Dia (meia-noite UTC, hora de Lisboa) e minuto de fim do evento: servem
  // para limitar o sync à janela pedida e para nunca apagar o que já passou.
  windowDate   DateTime
  startMinutes Int      @default(0)
  endMinutes   Int
  // Título enviado à Google: o modal de confirmação precisa dele para
  // mostrar o que vai ser removido (a linha é tudo o que sabemos).
  title        String   @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sourceKey])
  @@index([userId, windowDate])
}

/// Local ou compromisso recorrente (ex: um trabalho, o ginásio) com o seu
/// próprio tempo de deslocação. Os turnos agrupam-se aqui; mudar o nome ou
/// a deslocação atualiza todos os turnos (e o plano de estudo) de uma vez.
model Commitment {
  id             String @id @default(uuid())
  userId         String
  name           String
  // Minutos de viagem de cada lado de cada turno deste local.
  commuteMinutes Int    @default(0)
  // Morada do local (trabalho, evento, ginasio...) e meio de transporte
  // usados para CALCULAR commuteMinutes a partir de User.homeAddress via
  // Distance Matrix. Opcionais: o valor manual continua a ser o caminho
  // principal; a morada so existe para lembrar de onde veio o numero.
  address        String?
  commuteMode    CommuteMode @default(TRANSIT)
  // Folgas fixas: dias da semana (0=Domingo..6=Sábado) em que NUNCA se
  // trabalha aqui. Turnos semanais nesses dias não se criam nem se expandem;
  // turnos pontuais (troca de folga) continuam a valer. Validado em
  // CreateCommitmentDto/UpdateCommitmentDto (valores únicos, máx. 6).
  daysOff        Int[]  @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  shifts WorkShift[]

  @@unique([userId, name])
  @@index([userId])
}

/// Como as entradas de um componente de nota se juntam numa so nota.
enum GradeAggregation {
  AVERAGE
  BEST_OF
  DROP_LOWEST
}

/// Parte da nota de uma cadeira que NAO e uma task: seminarios semanais
/// (mini-avaliacoes), participacao, comportamento, trabalho de aula...
/// Existe por user + cadeira + periodo. Ter isto fora das Tasks e de
/// proposito: um seminario por semana criaria dezenas de tasks que
/// poluiriam a lista e o dashboard. A nota do componente (agregada das
/// entradas) entra nas medias como se fosse uma task com realGrade e
/// weightPercentage (ver grade-component-items.ts).
model GradeComponent {
  id       String @id @default(uuid())
  userId   String
  areaId   String
  periodId String

  name             String
  /// Peso na nota final da cadeira, em % (mesma unidade que Task.weightPercentage).
  weightPercentage Float
  aggregation      GradeAggregation @default(AVERAGE)
  /// So usado com BEST_OF: quantas das melhores notas contam.
  bestOfCount      Int?
  /// Quantas entradas se esperam no total (ex: 12 seminarios). So informativo.
  expectedEntries  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  area    Area           @relation(fields: [areaId], references: [id], onDelete: Cascade)
  period  AcademicPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  entries GradeEntry[]

  @@unique([userId, areaId, periodId, name])
  @@index([userId, periodId])
  @@index([areaId])
}

/// Uma nota dentro de um GradeComponent (ex: o seminario da semana 3).
model GradeEntry {
  id          String   @id @default(uuid())
  componentId String
  label       String?
  grade       Float
  date        DateTime?
  createdAt   DateTime @default(now())

  component GradeComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)

  @@index([componentId])
}

/// Papel de quem tem acesso aprovado a uma partilha AUTHORIZED.
enum ShareAccessRole {
  VIEWER
  EDITOR
  CO_OWNER
}

enum ChangeProposalStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Alteracao proposta por um EDITOR a uma entrada partilhada. Fica em
/// PENDING ate o dono aprovar (aplica `payload` a entrada) ou recusar. Um
/// editor so tem uma proposta PENDING por entrada: propor de novo substitui
/// a anterior, para o dono nao ficar com uma fila de rascunhos.
model NotebookChangeProposal {
  id               String               @id @default(uuid())
  notebookEntryId  String
  proposedByUserId String
  status           ChangeProposalStatus @default(PENDING)
  /// Campos propostos: { title?, textContent?, usefulLinks? }.
  payload          Json
  /// Mensagem opcional do editor para o dono.
  note             String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  decidedAt        DateTime?

  notebookEntry NotebookEntry @relation(fields: [notebookEntryId], references: [id], onDelete: Cascade)
  proposedBy    User          @relation(fields: [proposedByUserId], references: [id], onDelete: Cascade)

  @@index([notebookEntryId, status])
  @@index([proposedByUserId])
}

/// Area oficial que um user desligou: deixa de aparecer nos seletores dele
/// (dropdown de tasks, caderno, paleta). Não apaga nada - as tasks/notas que
/// já usam a Area continuam a funcionar e a Area continua visível na página
/// Áreas (com o interruptor) para a poder voltar a ligar.
model AreaHidden {
  userId    String
  areaId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  area Area @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@id([userId, areaId])
  @@index([areaId])
}

/// Subscrição Web Push de UM browser/dispositivo de um user (avisos de
/// pedidos de acesso/propostas no caderno partilhado). `endpoint` é único:
/// o mesmo browser nunca fica duplicado. `lang` é a língua da app nesse
/// dispositivo, para o servidor escrever o aviso na língua certa.
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  lang      String   @default("en")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Contador de visitas a um link de partilha, UMA linha por visitante.
/// viewerKey = "u:<userId>" (com sessão) ou "a:<hash>" (anónimo: HMAC do
/// IP + user-agent com um segredo do servidor - nunca o IP em claro).
/// O dono da entrada vê só: quem (nome, se tiver conta), quantas vezes e
/// a última vez. As visitas do próprio dono não contam.
model ShareVisit {
  id              String   @id @default(uuid())
  notebookShareId String
  viewerKey       String
  viewerUserId    String?
  count           Int      @default(1)
  firstVisitAt    DateTime @default(now())
  lastVisitAt     DateTime @default(now())

  notebookShare NotebookShare @relation(fields: [notebookShareId], references: [id], onDelete: Cascade)
  viewerUser    User?         @relation(fields: [viewerUserId], references: [id], onDelete: SetNull)

  @@unique([notebookShareId, viewerKey])
  @@index([notebookShareId, lastVisitAt])
}

enum FeedbackCategory {
  BUG
  IDEA
  TRANSLATION
  CONFUSING
  OTHER
}

/// Feedback escrito pelos users (qualquer língua). `language` = língua da
/// app quando foi enviado, para o admin saber o que está a ler/traduzir.
model Feedback {
  id        String           @id @default(uuid())
  userId    String?
  category  FeedbackCategory @default(OTHER)
  rating    Int?
  message   String
  language  String           @default("en")
  page      String?
  createdAt DateTime         @default(now())
  isResolved Boolean         @default(false)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([isResolved, createdAt])
}

/// Conjunto de tarefas pre-definidas que um aluno partilha com colegas de turma
/// (ex.: as entregas e testes de uma cadeira). Cada colega IMPORTA o pacote e
/// recebe as tarefas na sua conta, com data, peso e cadeira iguais para todos.
/// O acesso e por `code` (aleatorio, nao adivinhavel); apagar o pacote revoga-o.
model TaskPack {
  id          String   @id @default(uuid())
  ownerId     String
  name        String
  code        String   @unique
  importCount Int      @default(0)
  createdAt   DateTime @default(now())

  owner User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  items TaskPackItem[]

  @@index([ownerId])
}

/// Uma tarefa dentro de um pacote. Guarda so os parametros que sao iguais para
/// toda a turma: titulo, data, peso, cadeira e tipo. `areaId` so e preenchido
/// para Areas OFICIAIS (iguais para todos); numa Area pessoal fica null e quem
/// importa escolhe a sua (areaName serve de sugestao).
model TaskPackItem {
  id               String   @id @default(uuid())
  packId           String
  position         Int
  title            String
  dueDate          DateTime
  weightPercentage Float?
  areaId           String?
  areaName         String
  taskType         String
  academicType     String?
  effort           Effort?
  dateCertainty    DateCertainty @default(EXACT)
  availableFrom    DateTime?
  // Task do dono de onde o item foi copiado: "Push updates" volta a ler
  // dela. null = a task do dono foi apagada (o item fica como estava).
  sourceTaskId     String?
  // Sobe sempre que o dono publica uma alteracao ao item.
  version          Int           @default(1)
  // "Ainda nao da para comecar" (o enunciado ainda nao saiu): igual para a
  // turma, por isso tambem vai no pacote e nas atualizacoes.
  isBlocked        Boolean       @default(false)

  pack          TaskPack         @relation(fields: [packId], references: [id], onDelete: Cascade)
  sourceTask    Task?            @relation("PackItemSource", fields: [sourceTaskId], references: [id], onDelete: SetNull)
  importedTasks Task[]           @relation("ImportedFromPackItem")
  updates       TaskPackUpdate[]

  @@index([sourceTaskId])

  @@index([packId, position])
}

enum TaskPackUpdateStatus {
  PENDING
  ACCEPTED
  REJECTED
}

/// Alteracao de um item de pacote proposta a quem o importou. `changes` so
/// tem os campos partilhados que mudaram (title, date, weightPercentage,
/// effort, dateCertainty, availableFrom) com o valor novo, gerados pelo
/// servidor. No maximo um PENDING por task: uma alteracao nova junta-se a
/// que ainda nao foi respondida.
model TaskPackUpdate {
  id         String               @id @default(uuid())
  userId     String
  taskId     String
  packItemId String
  version    Int
  changes    Json
  status     TaskPackUpdateStatus @default(PENDING)
  createdAt  DateTime             @default(now())
  decidedAt  DateTime?

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  task     Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  packItem TaskPackItem @relation(fields: [packItemId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([taskId, status])
  @@index([packItemId])
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

// Amizade entre duas pessoas. Uma linha por par (o service impede a direcao
// inversa duplicada). So PENDING/ACCEPTED: recusar/cancelar/remover apaga a
// linha. Amizade NAO da acesso a nada por si so - ver pedidos de acesso.
model Friendship {
  id          String           @id @default(uuid())
  requesterId String
  addresseeId String
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  decidedAt   DateTime?

  requester User @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
}

// Bloqueio: quem bloqueia deixa de ser encontrado/contactado pelo bloqueado.
model UserBlock {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("BlockMaker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlockTarget", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

// Pedido/permissao de LEITURA das notas de uma pessoa a outra (so entre amigos).
// Uma linha por par. O dono escolhe, ao aprovar, QUAIS cadeiras (areaIds) a
// pessoa pode ler - nunca "tudo" por omissao. Editor/co-owner nao passam por
// aqui: so existem por item (NotebookShareAccessRequest).
model NotebookViewGrant {
  id        String                   @id @default(uuid())
  ownerId   String
  viewerId  String
  status    ShareAccessRequestStatus @default(PENDING)
  areaIds   String[]
  createdAt DateTime                 @default(now())
  decidedAt DateTime?

  owner  User @relation("ViewGrantOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  viewer User @relation("ViewGrantViewer", fields: [viewerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, viewerId])
  @@index([viewerId, status])
  @@index([ownerId, status])
}

enum FriendCodeChangeStatus {
  PENDING
  APPROVED
  REJECTED
}

// Pedido para trocar o codigo de amigo. O utilizador nao troca sozinho: pede ao
// admin com um motivo, e so a aprovacao gera o codigo novo.
model FriendCodeChangeRequest {
  id          String                 @id @default(uuid())
  userId      String
  reason      String                 @db.VarChar(500)
  status      FriendCodeChangeStatus @default(PENDING)
  adminNote   String?                @db.VarChar(300)
  createdAt   DateTime               @default(now())
  decidedAt   DateTime?
  decidedById String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

/// Cache de tempos de viagem entre duas moradas (Distance Matrix), por
/// utilizador e meio de transporte. Evita repetir pedidos pagos à Google
/// sempre que o itinerário do dia é calculado (sync, feed, plano de estudo).
/// origin/destination guardados normalizados (trim, espaços, minúsculas).
model TravelTime {
  id          String      @id @default(uuid())
  userId      String
  origin      String      @db.VarChar(300)
  destination String      @db.VarChar(300)
  mode        CommuteMode
  minutes     Int
  updatedAt   DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, origin, destination, mode])
}

// Registo diario do estado mental (um por dia). Escalas 1 a 5. Serve para
// cruzar humor com o foco das sessoes de estudo e o tempo estudado
// (WellbeingInsightsService). Dados de saude: so o proprio utilizador os ve.
model MoodLog {
  id     String @id @default(uuid())
  userId String
  // Meia-noite UTC do dia (hora de Lisboa), como WorkShift.date.
  date   DateTime
  mood   Int
  energy Int?
  stress Int?
  note   String? @db.VarChar(500)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

// DAILY = horas fixas com lembrete; AS_NEEDED = "se necessario", registado
// por toma (MedicationIntake), sem horas nem lembretes.
enum MedicationSchedule {
  DAILY
  AS_NEEDED
}

// Medicamento com lembrete diario as horas escolhidas, ou "se necessario".
// Nao e conselho medico: so um lembrete e um registo de tomas. De proposito
// nao guarda classes nem avalia doses ou combinacoes.
model Medication {
  id        String             @id @default(uuid())
  userId    String
  name      String             @db.VarChar(100)
  dosage    String?            @db.VarChar(60)
  schedule  MedicationSchedule @default(DAILY)
  // Minutos desde a meia-noite (Lisboa) de cada toma diaria, ordenados.
  // Vazio quando schedule = AS_NEEDED.
  times  Int[]
  // Desligar o lembrete sem apagar o medicamento nem o historico.
  remindersEnabled Boolean @default(true)
  active           Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  doses   MedicationDose[]
  intakes MedicationIntake[]

  @@index([userId])
}

// Uma toma "se necessario", registada pelo utilizador.
model MedicationIntake {
  id           String               @id @default(uuid())
  userId       String
  medicationId String
  takenAt      DateTime
  dose         String?              @db.VarChar(60)
  note         String?              @db.VarChar(200)

  createdAt DateTime @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  medication Medication  @relation(fields: [medicationId], references: [id], onDelete: Cascade)

  @@index([userId, takenAt])
  @@index([medicationId])
}

// Uma toma num dia e hora concretos. Criada quando o lembrete sai
// (remindedAt) ou quando o utilizador marca como tomada (takenAt), o que
// vier primeiro. O unique impede lembretes repetidos para a mesma toma.
model MedicationDose {
  id           String    @id @default(uuid())
  userId       String
  medicationId String
  date         DateTime
  slotMinutes  Int
  takenAt      DateTime?
  remindedAt   DateTime?

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  medication Medication @relation(fields: [medicationId], references: [id], onDelete: Cascade)

  @@unique([medicationId, date, slotMinutes])
  @@index([userId, date])
}

// Bloco de texto partilhado por nome, a ideia do dontpad: /pad/<slug> abre o
// mesmo texto para qualquer pessoa, com ou sem conta. Nao pertence a
// ninguem; updatedById so diz que conta escreveu por ultimo (null = sem
// conta). version serve de controlo de concorrencia otimista (ver
// PadsService.save).
model Pad {
  id          String  @id @default(uuid())
  slug        String  @unique @db.VarChar(100)
  content     String  @default("")
  version     Int     @default(0)
  updatedById String?
  // Gravacao sem conta: HMAC do IP (nunca o IP), so para a moderacao ver
  // que a mesma origem encheu varios pads de lixo.
  updatedByIpHash String? @db.VarChar(64)
  // Conta que trancou o pad: todos leem, so ela edita. Apagar a conta
  // destranca (SetNull). Pads trancados nao expiram.
  lockedById String?
  lockedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  updatedBy User? @relation("PadUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  lockedBy  User? @relation("PadLockedBy", fields: [lockedById], references: [id], onDelete: SetNull)

  // Expiracao: pads sem edicoes ha 90 dias (ver PadsService.deleteExpired).
  @@index([updatedAt])
  @@index([updatedByIpHash])
}

// Origem sem conta (hash do IP, ver Pad.updatedByIpHash) que um admin
// impediu de gravar pads. So bloqueia gravacoes sem conta; ler continua.
model PadBlockedSource {
  ipHash      String  @id @db.VarChar(64)
  blockedById String?

  createdAt DateTime @default(now())

  blockedBy User? @relation("PadSourceBlockedBy", fields: [blockedById], references: [id], onDelete: SetNull)
}

enum TurmaRole {
  DELEGADO
  MEMBER
}

// Turma: grupo de colegas com notas, ficheiros e avisos em comum. Entra-se
// com o inviteCode; o DELEGADO gere a turma (ver TurmasService).
model Turma {
  id                  String  @id @default(uuid())
  name                String  @db.VarChar(80)
  description         String? @db.VarChar(500)
  inviteCode          String  @unique @db.VarChar(16)
  // Desligado = so o delegado cria e edita notas da turma.
  membersCanEditNotes Boolean @default(true)
  createdById         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy     User?               @relation("TurmaCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  members       TurmaMember[]
  notes         TurmaNote[]
  files         TurmaFile[]
  announcements TurmaAnnouncement[]
  linkedAreas   TurmaLinkedArea[]
}

model TurmaMember {
  id      String    @id @default(uuid())
  turmaId String
  userId  String
  role    TurmaRole @default(MEMBER)

  joinedAt DateTime @default(now())

  turma Turma @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([turmaId, userId])
  @@index([userId])
}

// Nota da turma (nao de uma pessoa). version: concorrencia otimista, igual
// ao Pad.
model TurmaNote {
  id          String  @id @default(uuid())
  turmaId     String
  title       String  @db.VarChar(200)
  content     String  @default("")
  version     Int     @default(0)
  createdById String?
  updatedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  turma     Turma @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  createdBy User? @relation("TurmaNoteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User? @relation("TurmaNoteUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([turmaId, updatedAt])
}

// Ficheiro da turma. Mesmo bucket privado e mesma validacao dos anexos do
// Notebook (ver attachment-validation.util), caminho turmas/<turmaId>/...
model TurmaFile {
  id               String  @id @default(uuid())
  turmaId          String
  uploadedById     String?
  storagePath      String
  originalFileName String
  extension        String
  sizeBytes        Int

  createdAt DateTime @default(now())

  turma      Turma @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  uploadedBy User? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([turmaId, createdAt])
}

// Aviso do delegado (teste, prazo, mudanca de horario).
model TurmaAnnouncement {
  id       String  @id @default(uuid())
  turmaId  String
  authorId String?
  title    String  @db.VarChar(200)
  body     String  @db.VarChar(5000)

  createdAt DateTime @default(now())

  turma  Turma @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([turmaId, createdAt])
}

// Cadeira do caderno de um membro publicada na turma: os outros membros leem
// as entradas dessa cadeira (menos as privadas, privateFromFriends).
model TurmaLinkedArea {
  id      String @id @default(uuid())
  turmaId String
  userId  String
  areaId  String

  createdAt DateTime @default(now())

  turma Turma @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  area  Area  @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@unique([turmaId, userId, areaId])
  @@index([turmaId])
}
